{
  "_schema": "sports_catalog.v1",
  "_note": "Maps The Odds API sport-key prefixes to a family code. The LONGEST matching prefix wins; a key matching nothing is OTHER. Read by src/sports/catalog.py, src/pipeline/allsports_capture.py, src/pipeline/allsports_scores.py, src/hounds/user_spec.py and src/pipeline/snapshots.py (window margins). markets = what an all-sports capture buys for the family (h2h for every family; spreads and totals only where the sport has them AND the scores feed can grade them). capture = dedicated means an existing pipeline (dense, nfl_capture, mma_capture) already buys that key, so the all-sports capture never does. settles = how a member-dog bet on the family is graded: existing (MLB/NFL results stores), odds_api_scores (src/pipeline/allsports_scores.py), free_results (a free ESPN feed, src/pipeline/allsports_free_results.py: tennis and MMA, whose results land in the same allsports_scores store), none (no result source: the bet voids after 72 hours, so the family stays off the dog menu). dog_menu = offered to dog builders. scores_verified = a real result fetch has returned results for the family (for odds_api_scores families a real /scores call, false until the orchestrator spends the credit to check; for free_results families a real fetch of the free feed, matched against the odds feed's own names, 2026-10-19/20). draw_possible = the team moneyline is a three-way market, so a level final score LOSES a team moneyline; where it is false a level score is a PUSH.",
  "capture": {
    "enabled": true,
    "daily_cap_credits": 1500,
    "inplay_daily_cap_credits": 450,
    "scores_daily_cap_credits": 300,
    "max_calls_per_run": 60,
    "regions": ["us"],
    "phases_minutes": {"t24h": 1440, "t6h": 360, "t2h": 120, "t30m": 30},
    "store_horizon_hours": 36,
    "inplay_cadence_minutes": 30,
    "inplay_markets": ["h2h"],
    "events_idle_recheck_hours": 6,
    "events_lookahead_hours": 25,
    "dark_after_empty_captures": 2,
    "dark_retry_hours": 24,
    "scores_poll_interval_hours": 8,
    "scores_days_from": 3,
    "free_results_poll_interval_hours": 1,
    "void_after_hours": 72,
    "skip_key_prefixes": ["politics_", "golf_"],
    "skip_key_suffixes": ["_winner", "_winners", "_outright", "_outrights", "_futures"]
  },
  "families": {
    "MLB": {"label": "MLB", "prefixes": ["baseball_mlb"], "markets": ["h2h", "spreads", "totals"],
            "start_word": "first pitch", "since_margin_days": 4, "live_window_hours": 4.5,
            "capture": "dedicated", "settles": "existing", "dog_menu": true, "scores_verified": true, "draw_possible": false},
    "NFL": {"label": "NFL", "prefixes": ["americanfootball_nfl"], "markets": ["h2h", "spreads", "totals"],
            "start_word": "kickoff", "since_margin_days": 16, "live_window_hours": 4.5,
            "capture": "dedicated", "settles": "existing", "dog_menu": true, "scores_verified": true, "draw_possible": false},
    "NCAAF": {"label": "College football", "prefixes": ["americanfootball_ncaaf"], "markets": ["h2h", "spreads", "totals"],
              "start_word": "kickoff", "since_margin_days": 4, "live_window_hours": 4.5,
              "capture": "allsports", "settles": "odds_api_scores", "dog_menu": true, "scores_verified": false, "draw_possible": false},
    "GRIDIRON": {"label": "Other American football (CFL, UFL)", "prefixes": ["americanfootball_"], "markets": ["h2h", "spreads", "totals"],
                 "start_word": "kickoff", "since_margin_days": 4, "live_window_hours": 4.5,
                 "capture": "allsports", "settles": "odds_api_scores", "dog_menu": true, "scores_verified": false, "draw_possible": false},
    "NBA": {"label": "NBA", "prefixes": ["basketball_nba"], "markets": ["h2h", "spreads", "totals"],
            "start_word": "tip-off", "since_margin_days": 4, "live_window_hours": 3.5,
            "capture": "allsports", "settles": "odds_api_scores", "dog_menu": true, "scores_verified": false, "draw_possible": false},
    "WNBA": {"label": "WNBA", "prefixes": ["basketball_wnba"], "markets": ["h2h", "spreads", "totals"],
             "start_word": "tip-off", "since_margin_days": 4, "live_window_hours": 3.5,
             "capture": "allsports", "settles": "odds_api_scores", "dog_menu": true, "scores_verified": false, "draw_possible": false},
    "NCAAB": {"label": "College basketball", "prefixes": ["basketball_ncaab", "basketball_wncaab"], "markets": ["h2h", "spreads", "totals"],
              "start_word": "tip-off", "since_margin_days": 4, "live_window_hours": 3.0,
              "capture": "allsports", "settles": "odds_api_scores", "dog_menu": true, "scores_verified": false, "draw_possible": false},
    "BASKETBALL": {"label": "Other basketball (Euroleague and more)", "prefixes": ["basketball_"], "markets": ["h2h", "spreads", "totals"],
                   "start_word": "tip-off", "since_margin_days": 4, "live_window_hours": 3.0,
                   "capture": "allsports", "settles": "odds_api_scores", "dog_menu": true, "scores_verified": false, "draw_possible": false},
    "NHL": {"label": "NHL", "prefixes": ["icehockey_nhl"], "markets": ["h2h", "spreads", "totals"],
            "start_word": "puck drop", "since_margin_days": 4, "live_window_hours": 3.5,
            "capture": "allsports", "settles": "odds_api_scores", "dog_menu": true, "scores_verified": false, "draw_possible": false},
    "HOCKEY": {"label": "Other hockey", "prefixes": ["icehockey_"], "markets": ["h2h", "spreads", "totals"],
               "start_word": "puck drop", "since_margin_days": 4, "live_window_hours": 3.5,
               "capture": "allsports", "settles": "odds_api_scores", "dog_menu": true, "scores_verified": false, "draw_possible": false},
    "BASEBALL": {"label": "Other baseball (KBO, NPB, minors)", "prefixes": ["baseball_"], "markets": ["h2h", "spreads", "totals"],
                 "start_word": "first pitch", "since_margin_days": 4, "live_window_hours": 4.5,
                 "capture": "allsports", "settles": "odds_api_scores", "dog_menu": true, "scores_verified": false, "draw_possible": false},
    "SOCCER": {"label": "Soccer", "prefixes": ["soccer_"], "markets": ["h2h", "totals"],
               "start_word": "kick-off", "since_margin_days": 4, "live_window_hours": 2.75,
               "capture": "allsports", "settles": "odds_api_scores", "dog_menu": true, "scores_verified": false, "draw_possible": true,
               "region_ladder": ["us", "eu"]},
    "TENNIS": {"label": "Tennis (ATP, WTA)", "prefixes": ["tennis_"], "markets": ["h2h"],
               "start_word": "first serve", "since_margin_days": 4, "live_window_hours": 4.0,
               "capture": "allsports", "settles": "free_results", "dog_menu": true, "scores_verified": true, "draw_possible": false,
               "settles_note": "Results come from ESPN's free public ATP and WTA scoreboards (src/providers/espn_tennis_results.py), not The Odds API /scores, which has no tennis. A retirement after at least one completed set counts for the player who advanced; a retirement before a set completes, and a walkover, are void. ESPN has no Challenger or ITF scoreboard, so those matches never match a result and void after 72 hours; a match whose two players cannot be matched with certainty is never graded and voids the same way. Only h2h is captured (tennis spreads and totals are in games)."},
    "CRICKET": {"label": "Cricket", "prefixes": ["cricket_"], "markets": ["h2h"],
                "start_word": "first ball", "since_margin_days": 5, "live_window_hours": 9.0,
                "capture": "allsports", "settles": "odds_api_scores", "dog_menu": true, "scores_verified": false, "draw_possible": true,
                "region_ladder": ["us", "au", "uk"]},
    "MMA": {"label": "MMA", "prefixes": ["mma_"], "markets": ["h2h"],
            "start_word": "start", "since_margin_days": 16, "live_window_hours": 6.0,
            "capture": "dedicated", "settles": "free_results", "dog_menu": true, "scores_verified": true, "draw_possible": false,
            "settles_note": "Results come from ESPN's free UFC data through the existing grader (src/providers/espn_mma_results.py), not The Odds API /scores, which has no MMA. A draw, a no contest or a bout ESPN calls cancelled is void. Only UFC and Contender Series bouts are on ESPN: a bout of any other promotion (KSW, Oktagon, PFL and so on) never matches a result and voids after 72 hours, as does a bout whose fighters cannot be matched with certainty."},
    "BOXING": {"label": "Boxing", "prefixes": ["boxing_"], "markets": ["h2h"],
               "start_word": "start", "since_margin_days": 8, "live_window_hours": 6.0,
               "capture": "allsports", "settles": "none", "dog_menu": false, "scores_verified": false, "draw_possible": true,
               "settles_note": "No result source for boxing. Off the dog menu until one exists."},
    "RUGBY": {"label": "Rugby (league and union)", "prefixes": ["rugby"], "markets": ["h2h", "spreads", "totals"],
              "start_word": "kick-off", "since_margin_days": 4, "live_window_hours": 2.5,
              "capture": "allsports", "settles": "odds_api_scores", "dog_menu": true, "scores_verified": false, "draw_possible": true,
              "region_ladder": ["us", "au", "uk"]},
    "AFL": {"label": "Aussie rules (AFL)", "prefixes": ["aussierules_"], "markets": ["h2h", "spreads", "totals"],
            "start_word": "first bounce", "since_margin_days": 4, "live_window_hours": 3.0,
            "capture": "allsports", "settles": "odds_api_scores", "dog_menu": true, "scores_verified": false, "draw_possible": true,
            "region_ladder": ["us", "au"]},
    "OTHER": {"label": "Other sports", "prefixes": [""], "markets": ["h2h"],
              "start_word": "start", "since_margin_days": 4, "live_window_hours": 4.0,
              "capture": "allsports", "settles": "none", "dog_menu": false, "scores_verified": false, "draw_possible": false,
              "settles_note": "Catch-all for keys no family claims. Captured and shown, off the dog menu: no result source is known."}
  }
}
