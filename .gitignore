# Secrets -- never commit these. The repository is public.
.env
.env.*
!.env.example
*.key
*.pem
credentials.json

# Generated data. Raw pulls and processed slates are reproducible from the
# providers; committing them bloats history and can leak API responses.
data/raw/*
data/processed/*
data/historical/*
!data/**/.gitkeep

# App state (users, tokens, saved bets) -- src/appstate/*.py. Real user
# data, not reproducible from a provider, and definitely not something to
# commit: it holds (hashed) auth tokens and per-user records. APP_DB_PATH
# overrides the location; this ignores the default path only.
data/app/*
!data/app/.gitkeep

# evidence/ is deliberately NOT ignored. Predictions and mismatch flags are
# unbackfillable: they are evidence only because they were written down before the
# games, carrying the prices available at that moment. Nobody can reconstruct them
# afterwards at any cost, so unlike everything under data/ they are tracked.

# FORWARD ODDS CAPTURES ARE EVIDENCE, NOT GENERATED DATA -- tracked for exactly
# the reason above. The rules over data/processed/ were written when that
# directory held reproducible provider pulls; forward captures were added to it
# later and silently inherited an ignore meant for regenerable files. They are
# not regenerable: a price observed at 19:47 tonight cannot be fetched back at
# any price tomorrow, and this project runs on ephemeral containers whose disks
# are reclaimed. Found 2026-08-31 with five days of h2h snapshots and a day of
# multi-book boards living nowhere but one container's disk.
!data/processed/odds_snapshots.jsonl
!data/processed/odds_multibook.jsonl
!data/processed/f5_close.jsonl
!data/processed/prop_listing.jsonl

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# artifacts/ IS tracked: demo_latest.html is the known-good snapshot that must
# survive any later refactor. Dated briefings are regenerable and are not.
artifacts/briefing.html
artifacts/analyze_*.html
