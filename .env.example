# Copy to .env and fill in. NEVER commit .env -- this repository is public.

# The Odds API (https://the-odds-api.com) -- free tier is sufficient.
# Everything odds-related is gated on this key and fails safe without it.
ODDS_API_KEY=

# Optional. Preferred sportsbook key, e.g. draftkings or fanduel.
# Leave blank to use the first book offering the market.
DEFAULT_BOOK=

ODDS_API_REGION=us
ODDS_API_MARKETS=h2h,spreads,totals
ODDS_API_ODDS_FORMAT=american
