# Keeps the build context (and therefore what could ever reach a build
# step) to what deploy/Dockerfile actually COPYs. In particular .env and
# .git must never be sent to a docker daemon -- see .gitignore's own
# "Secrets" block for why .env is never committed either.
.git/
.env
.env.*
!.env.example
*.key
*.pem
credentials.json

__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# Everything under data/ except what deploy/Dockerfile explicitly COPYs
# (data/processed/, data/watch/, data/app/.gitkeep) -- no reason to send
# data/raw or data/historical into the build context at all.
data/*
!data/processed/
!data/watch/
!data/app/
data/app/*
!data/app/.gitkeep
# Paper-account ledgers: read by the Performance surface (2026-09-07).
!data/paper_accounts/
# F-2 (2026-09-07): the historical stores the matchup page reads for team
# records, starter form, bullpen workload, posted lineups and handedness.
# They are git-ignored and live in the daily-loop actions/cache; the deploy
# workflow restores that cache before building so they are present here.
# Only these five files -- data/historical/statcast (pitch-level, ~40 MB)
# stays out of the image until something on a customer route reads it.
!data/historical/
data/historical/*
!data/historical/mlb_results.csv
!data/historical/mlb_results.manifest.json
!data/historical/pitcher_logs.jsonl
!data/historical/bullpen_log.jsonl
!data/historical/lineups.jsonl
!data/historical/handedness.json

design/
docs/
artifacts/
# evidence/ is COPYd now (Performance + Opportunities surfaces read the
# engine ledgers) -- see deploy/Dockerfile.
.claude/
