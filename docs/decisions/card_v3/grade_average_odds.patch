+GRADED_AT_AVERAGE = "average"
+GRADED_AT_BEST_NO_AVERAGE = "best_price_no_average_recorded"
+
+
+def _grade_at_average_odds(entry: Mapping, grade: dict) -> dict:
+    """Re-price a WIN/LOSS grade at the board's AVERAGE odds (CARD V3 PATCH 2).
+
+    The owner ruled on 2026-09-21 that picks are graded at average odds. The
+    ledger instead graded every entry at `price`, the BEST quote any book
+    showed (loss diagnosis 03: the same 170 bets are -4.11 units at the board
+    average against -0.69 at the best price). This keeps both:
+
+    * `profit_units` is the one every reader sums (`record_v2`, `history_v2`,
+      the per-day totals), and is now at the average;
+    * `profit_units_at_best` is the profit at the recorded best `price`, the
+      figure the ledger used to publish, kept so the difference is never
+      hidden;
+    * `graded_price_basis` says which price `profit_units` used. An entry
+      frozen before the average was recorded (or on a board too thin to
+      average) has no average to grade at; it stays graded at its best price
+      and SAYS so, rather than receiving a guessed average.
+
+    A grade that is not a WIN or LOSS (push, void, unresolved) has no price
+    to re-take and is returned untouched.
+    """
+    result = grade.get("result")
+    if result not in (RESULT_WIN, RESULT_LOSS):
+        return grade
+    out = dict(grade)
+    out["profit_units_at_best"] = grade.get("profit_units")
+    average = entry.get("average_decimal")
+    if (isinstance(average, (int, float)) and not isinstance(average, bool)
+            and average > 1.0):
+        out["profit_units"] = (round(float(average) - 1.0, 4)
+                               if result == RESULT_WIN else -1.0)
+        out["graded_price_basis"] = GRADED_AT_AVERAGE
+    else:
+        out["graded_price_basis"] = GRADED_AT_BEST_NO_AVERAGE
+    return out
+
+
