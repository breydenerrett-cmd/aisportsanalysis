+def average_decimal(books: Mapping, side: str, *, two_way: bool = True) -> Optional[float]:
+    """Mean DECIMAL price for `side` across the books the board counted.
+
+    CARD V3 PATCH 2 (docs/decisions/card_v3/README.md). The owner's
+    2026-09-21 ruling is that picks are graded at AVERAGE odds, not at the
+    best price any book showed; `fair_and_best` returns only the best, so the
+    ruling was never implemented and the public record claimed a price basis
+    that was never applied (loss diagnosis 03, finding 4).
+
+    The population is exactly the one `fair_and_best` reads its fair price
+    and best price from: books quoting BOTH sides whose two raw
+    probabilities sum to at least `MIN_TWO_WAY_BOOKSUM`, and at least
+    `MIN_BOOKS` of them. The best price is therefore the maximum of the same
+    set this averages, so the two numbers are comparable. `two_way=False`
+    (home runs: no book quotes the Under) averages every book quoting the
+    side. A mean of DECIMAL prices, not of American numbers (which are not on
+    a common scale across the -100/+100 seam) and not of implied
+    probabilities: the decimal mean is the payout a bettor drawing a book at
+    random would have been paid per unit staked, which is what a grade at
+    "average odds" means. `None` when the board cannot support an average.
+    """
+    prices = []
+    for _book, sides in (books or {}).items():
+        mine = sides.get(side)
+        if mine is None:
+            continue
+        try:
+            if two_way:
+                other = sides.get("Under" if side == "Over" else "Over")
+                if other is None:
+                    continue
+                raw = (odds_math.american_to_probability(mine)
+                       + odds_math.american_to_probability(other))
+                if raw < MIN_TWO_WAY_BOOKSUM:
+                    continue
+            prices.append(odds_math.american_to_decimal(mine))
+        except (odds_math.OddsError, TypeError, ValueError, ZeroDivisionError):
+            continue
+    if not prices or (two_way and len(prices) < MIN_BOOKS):
+        return None
+    return sum(prices) / len(prices)
+
+
