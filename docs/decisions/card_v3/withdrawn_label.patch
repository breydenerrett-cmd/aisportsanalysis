+def _tally_entries(entries) -> dict:
+    """W-L-units for a list of graded entries, in `record_v2`'s own figure
+    shape (CARD V3 PATCH 5)."""
+    fig = {"wins": 0, "losses": 0, "pushes": 0, "voids": 0, "unresolved": 0,
+           "n_staked": 0, "profit_units": 0.0}
+    for entry in entries:
+        result = entry.get("result")
+        if result == RESULT_WIN:
+            fig["wins"] += 1
+        elif result == RESULT_LOSS:
+            fig["losses"] += 1
+        elif result == RESULT_PUSH:
+            fig["pushes"] += 1
+        elif result == RESULT_VOID:
+            fig["voids"] += 1
+        elif result == RESULT_UNRESOLVED:
+            fig["unresolved"] += 1
+        if result in (RESULT_WIN, RESULT_LOSS):
+            fig["n_staked"] += 1
+            fig["profit_units"] += entry.get("profit_units") or 0.0
+    fig["profit_units"] = round(fig["profit_units"], 4)
+    return fig
+
