@@ -3314,6 +3340,7 @@ def record_v2(*, path: Optional[str] = None, since: Optional[str] = None,
                 _add(main_fig, entry)
                 _add(combined, entry)
 
+    withdrawn_graded = _tally_entries(withdrawn_entries)
     for fig in (main_fig, plus_fig, fills_fig, combined):
         fig["days"] = len(days_seen)
