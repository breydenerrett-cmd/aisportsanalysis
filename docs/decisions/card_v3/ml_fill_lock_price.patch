         fresh_entry = fresh_by_key.get(key)
 
         if _is_locked_v2(entry, moment, lock_lead_hours):
+            if _is_moneyline_fill(entry):
+                relocked = _lock_moneyline_fill_at_board_price(
+                    entry, fresh_entry, moment)
+                (withdrawn if relocked.get("withdrawn") else merged).append(relocked)
+                seen.add(key)
+                continue
             stamped = dict(entry)
             stamped["locked"] = True
             stamped["locked_at"] = moment.isoformat()
