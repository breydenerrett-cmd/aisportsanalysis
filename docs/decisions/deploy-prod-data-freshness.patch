             sleep 10
           done
           echo "up; now exercising the page path"
+          # The request-time stores (results, pitcher/bullpen logs, standings) are
+          # refreshed at image build and by the container's own guard; /health
+          # reports how current each is. A stale core store is a warning, never a
+          # failed deploy: the pages say what their data covers.
+          fresh=$(curl -s "$BASE/health" || echo '{}')
+          case "$fresh" in
+            *'"core_stale":[]'*) echo "data freshness: core stores current" ;;
+            *) echo "::warning::a core data store is stale on linehound-prod -- see data_freshness in /health" ;;
+          esac
 
           ET=$(TZ=America/New_York date +%Y-%m-%d)
